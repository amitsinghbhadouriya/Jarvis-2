# Jarvis 2 - Environment Variables Configuration Template
# Copy this file to .env and configure values for your local environment

# Application Settings
APP_NAME=Jarvis
APP_ENV=development
APP_HOST=localhost
APP_PORT=8000
DEBUG=False

# Audio & Speech Synthesis
TTS_RATE=175
TTS_VOLUME=0.9
TTS_VOICE_INDEX=0

# Speech Recognition
SPEECH_TIMEOUT=8
SPEECH_PHRASE_TIME_LIMIT=6
SPEECH_ENERGY_THRESHOLD=300
HOTWORD=jarvis

# Face Authentication
FACE_AUTH_ENABLED=True
FACE_AUTH_FRAMES=30
CAMERA_INDEX=0

# Database
DB_NAME=jarvis.db
